SECRET_KEY=django-insecure-replace-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/veritas_db
MONGO_DB_NAME=veritas_db

# Redis Configuration (Used for rate limits, session, cache, Celery)
REDIS_URL=redis://localhost:6379/0

# JWT Lifetime Settings
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
